<UserControl x:Class="VdHelper.Views.ParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VdHelper.Views"
             DataContext="{x:Static vm:ParametersViewModel.Current}">
    <Grid Margin="18,14,18,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Muted}" Text="{Binding Summary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Style="{StaticResource Mono}" Margin="0,0,0,10"
                   Text="改配置前必须先退出 Streamer：它有 2 秒防抖保存，会把外部写入覆盖掉。写入时自动备份为 .vdhelper.bak。只读项分两种：DPAPI 密文（改了会清空配对），以及 Streamer 自己就不持久化的键（源码上带 [JsonIgnore]，本机写了也没用）。头显侧项在本机不落盘，只能在头显里改。" />

        <ListView Grid.Row="2" ItemsSource="{Binding Rows}"
                  Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource ChromeText}" FontSize="12.5" Text="{Binding Key}" />
                            <TextBlock Style="{StaticResource Mono}" Text="{Binding Badges}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ChromeText}"
                                   FontSize="12.5" Text="{Binding Current}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Margin="10,0,10,0">
                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis" Text="{Binding Effect}" />
                            <TextBlock Style="{StaticResource Mono}" FontSize="{StaticResource FsMeta}"
                                       Text="{Binding SourceText, StringFormat=来源 {0}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="11.5"
                                       Margin="0,0,8,0" Text="{Binding State}" />
                            <Button Content="切换" MinWidth="64" Height="24"
                                    Command="{Binding ToggleCommand}"
                                    Visibility="{Binding Editable, Converter={StaticResource BoolToVisible}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>