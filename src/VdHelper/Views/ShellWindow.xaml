<Window x:Class="VdHelper.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VdHelper.Views"
        Title="VDHelper — Virtual Desktop 串流体检"
        Width="1060" Height="720" MinWidth="880" MinHeight="560"
        Background="{StaticResource ChromeBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Virtual Desktop 串流体检" Style="{StaticResource H1}" />
                    <TextBlock Text="检测 PC 与 Quest 之间的链路断在哪一环，并给出可回滚的修复。"
                               Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                           Text="{Binding VerdictText}"
                           Foreground="{Binding Verdict, Converter={StaticResource StatusBrush}}" />
            </Grid>
        </Border>

        <!-- body -->
        <TabControl Grid.Row="1" Margin="16,14,16,8" Background="Transparent" BorderThickness="0">
            <TabItem Header="本机体检" Padding="18,8">
                <views:HealthView />
            </TabItem>
        </TabControl>

        <!-- status bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <TextBlock Margin="20,8" Style="{StaticResource Muted}" Text="{Binding StatusText}" />
        </Border>
    </Grid>
</Window>