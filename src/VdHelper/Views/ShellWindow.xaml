<Window x:Class="VdHelper.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VdHelper.Views"
        Title="VDHelper — Virtual Desktop 串流体检"
        Width="980" Height="680" MinWidth="840" MinHeight="560"
        Background="{StaticResource BodyBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="8"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!-- Title bar / body / status bar: 48 / * / 48, as in the official chrome. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource TitleBrush}" MouseLeftButtonDown="OnDrag">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="Virtual Desktop 串流体检" Style="{StaticResource H1}" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0"
                           FontFamily="{StaticResource UiFont}" FontSize="{StaticResource BodySize}"
                           Text="{Binding VerdictText}"
                           Foreground="{Binding Verdict, Converter={StaticResource StatusBrush}}" />
                <Button Grid.Column="2" Content="—" Width="46" MinWidth="46" Padding="0" FontSize="15" Click="OnMinimize" />
                <Button Grid.Column="3" Content="✕" Width="46" MinWidth="46" Padding="0" FontSize="14" Click="OnClose" />
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="0" Background="{StaticResource ContentBrush}"
                    TabStripPlacement="Left">
            <TabItem Header="本机体检" Style="{StaticResource NavTab}">
                <views:HealthView />
            </TabItem>
            <TabItem Header="串流参数" Style="{StaticResource NavTab}">
                <views:ParametersView />
            </TabItem>
            <TabItem Header="头显诊断" Style="{StaticResource NavTab}">
                <views:HeadsetView />
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource TitleBrush}">
            <Grid Margin="20,0,20,0">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}"
                           Text="{Binding StatusText}" />
            </Grid>
        </Border>
    </Grid>
</Window>