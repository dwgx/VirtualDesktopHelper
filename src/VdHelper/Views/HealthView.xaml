<UserControl x:Class="VdHelper.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VdHelper.Views"
             DataContext="{x:Static vm:HealthViewModel.Current}">
    <Grid Margin="18,14,18,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- What to do next, above the 34-row list. A verdict alone is not actionable, and the
             first thing people do with a long list is close the window. No cap: an earlier
             version showed the top six and that silently hid the most informative finding. -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="10,7" CornerRadius="3" Background="#141414"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Style="{StaticResource ChromeText}" FontSize="12" Text="接下来做什么" />
                    <TextBlock Style="{StaticResource Muted}" Margin="8,0,0,0" FontSize="11.5"
                               Text="{Binding ActionsHint}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="11" FontWeight="700"
                                           VerticalAlignment="Center" Text="{Binding Tag}"
                                           Foreground="{Binding Accent}" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                           Foreground="#C9D0DE">
                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                    <Run Text=" — " Foreground="#6B7385" />
                                    <Run Text="{Binding What, Mode=OneWay}" Foreground="#9AA0A6" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <!-- symptom entry: the one binary split every human triage does by hand -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Symptoms}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,6,6" Padding="10,4" CornerRadius="3"
                            Background="#161616" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Background" Value="#1E2A38" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource ChromeText}" FontSize="12"
                                   Text="{Binding Label}">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding SelectCommand}" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" Margin="0,0,0,10" Padding="10,6" CornerRadius="3" Background="#161616"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <TextBlock Style="{StaticResource Muted}" Text="{Binding SymptomHint}" />
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6"
                       Text="每项都能展开看到原始输出。所有修复先备份、可回滚；路由器这类本机改不了的只给指引。" />
            <!-- On-demand deep probe. The pass only takes a quick loss sample; this is the
                 20-sample run for "the picture keeps stuttering even though everything is green". -->
            <StackPanel Orientation="Horizontal">
                <Button Content="深度探测丢包（20 次采样）" MinWidth="180" Height="24"
                        Command="{Binding DeepProbeCommand}" />
                <TextBlock Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"
                           Text="画面卡但各项都绿的时候跑这个" />
            </StackPanel>
            <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,0"
                       TextWrapping="Wrap" Foreground="#9AA0A6" Text="{Binding DeepProbeText}" />
        </StackPanel>


        <ListView Grid.Row="4" ItemsSource="{Binding Rows}"
                  Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="Rule" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="0,1,0,0" SnapsToDevicePixels="True">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- P1-9. There was no selected or focused state at all, so the
                                         list could not be navigated and a click gave no feedback. -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Rule" Property="Background" Value="#1F2E79BD" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="Rule" Property="Background" Value="#14243052" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Expander Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="{Binding AccessibilityName}"
                                AutomationProperties.HelpText="{Binding Detail}">
                        <Expander.Header>
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <!-- P1-6. This column is why a row can be matched to a report
                                         line or an issue. The id was bound in two other places in this
                                         file and never here, so it was invisible on the one screen
                                         where you would look for it. Narrow on purpose: the id is
                                         mono and meta-sized, and the summary has to stay readable. -->
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Padding="6,1" CornerRadius="2" Background="#1E1E1E">
                                               <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                   <!-- Shape before colour: the badge has to survive greyscale and colour blindness. -->
                                                   <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"
                                                         Data="{Binding Status, Converter={StaticResource StatusGlyph}}"
                                                         Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                   <TextBlock FontSize="11.5"
                                                              Text="{Binding Status, Converter={StaticResource StatusText}}"
                                                              Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                               </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"
                                           FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Margin="10,0,0,0" Style="{StaticResource ChromeText}" FontSize="13"
                                           Text="{Binding Summary}" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel Margin="74,4,0,10">
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" />

                            <ItemsControl ItemsSource="{Binding Fixes}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10" CornerRadius="3"
                                                Background="#161616" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Style="{StaticResource ChromeText}"
                                                               FontSize="12.5" Text="{Binding Title}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   Style="{StaticResource Muted}" FontSize="11.5"
                                                                   Text="{Binding Risk, StringFormat=风险 {0}}" />
                                                        <Button Content="执行" MinWidth="72" Height="24"
                                                                Command="{Binding ApplyCommand}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,0"
                                                           Text="{Binding What, StringFormat=执行：{0}}" />
                                                <TextBlock Style="{StaticResource Mono}"
                                                           Text="{Binding Backup, StringFormat=备份：{0}}" />
                                                <TextBlock Style="{StaticResource Mono}"
                                                           Text="{Binding Rollback, StringFormat=回滚：{0}}" />
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,0"
                                                           Text="{Binding LastMessage}"
                                                           Visibility="{Binding LastMessage, Converter={StaticResource StringToVisible}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Text="{Binding GuidanceText, StringFormat=指引：{0}}"
                                       Visibility="{Binding HasGuidance, Converter={StaticResource BoolToVisible}}" />

                            <TextBlock Style="{StaticResource Mono}" Margin="0,8,0,0"
                                       Text="{Binding EvidenceText, StringFormat=原始输出：{0}}" />
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>