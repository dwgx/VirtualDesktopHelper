<UserControl x:Class="VdHelper.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VdHelper.Views"
             DataContext="{x:Static vm:HealthViewModel.Current}">
    <Grid Margin="18,14,18,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- symptom entry: the one binary split every human triage does by hand -->
        <ItemsControl Grid.Row="0" ItemsSource="{Binding Symptoms}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,6,6" Padding="10,4" CornerRadius="3"
                            Background="#161616" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Background" Value="#1E2A38" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource ChromeText}" FontSize="12"
                                   Text="{Binding Label}">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding SelectCommand}" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="1" Margin="0,0,0,10" Padding="10,6" CornerRadius="3" Background="#161616"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <TextBlock Style="{StaticResource Muted}" Text="{Binding SymptomHint}" />
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6"
                       Text="每项都能展开看到原始输出。所有修复先备份、可回滚；路由器这类本机改不了的只给指引。" />
            <!-- On-demand deep probe. The pass only takes a quick loss sample; this is the
                 20-sample run for "the picture keeps stuttering even though everything is green". -->
            <StackPanel Orientation="Horizontal">
                <Button Content="深度探测丢包（20 次采样）" MinWidth="180" Height="24"
                        Command="{Binding DeepProbeCommand}" />
                <TextBlock Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"
                           Text="画面卡但各项都绿的时候跑这个" />
            </StackPanel>
            <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,0"
                       TextWrapping="Wrap" Foreground="#9AA0A6" Text="{Binding DeepProbeText}" />
        </StackPanel>


        <ListView Grid.Row="3" ItemsSource="{Binding Rows}"
                  Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Expander Background="Transparent" BorderThickness="0">
                        <Expander.Header>
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Padding="6,1" CornerRadius="2" Background="#1E1E1E">
                                    <TextBlock FontSize="11.5"
                                               Text="{Binding Status, Converter={StaticResource StatusText}}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                </Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Margin="10,0,0,0" Style="{StaticResource ChromeText}" FontSize="13"
                                           Text="{Binding Summary}" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel Margin="74,4,0,10">
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" />

                            <ItemsControl ItemsSource="{Binding Fixes}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10" CornerRadius="3"
                                                Background="#161616" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Style="{StaticResource ChromeText}"
                                                               FontSize="12.5" Text="{Binding Title}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   Style="{StaticResource Muted}" FontSize="11.5"
                                                                   Text="{Binding Risk, StringFormat=风险 {0}}" />
                                                        <Button Content="执行" MinWidth="72" Height="24"
                                                                Command="{Binding ApplyCommand}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,0"
                                                           Text="{Binding What, StringFormat=执行：{0}}" />
                                                <TextBlock Style="{StaticResource Mono}"
                                                           Text="{Binding Backup, StringFormat=备份：{0}}" />
                                                <TextBlock Style="{StaticResource Mono}"
                                                           Text="{Binding Rollback, StringFormat=回滚：{0}}" />
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,0"
                                                           Text="{Binding LastMessage}"
                                                           Visibility="{Binding LastMessage, Converter={StaticResource StringToVisible}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Text="{Binding GuidanceText, StringFormat=指引：{0}}"
                                       Visibility="{Binding HasGuidance, Converter={StaticResource BoolToVisible}}" />

                            <TextBlock Style="{StaticResource Mono}" Margin="0,8,0,0"
                                       Text="{Binding EvidenceText, StringFormat=原始输出：{0}}" />
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>