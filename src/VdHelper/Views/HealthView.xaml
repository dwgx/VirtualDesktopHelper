<UserControl x:Class="VdHelper.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VdHelper.Views"
             DataContext="{x:Static vm:HealthViewModel.Current}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Muted}" Margin="4,0,4,10"
                   Text="每一项都能展开看到原始输出。所有修复动作先备份、后执行、可回滚；路由器等本机改不了的设置只给指引。" />

        <ListView Grid.Row="1" ItemsSource="{Binding Rows}"
                  Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Expander Margin="0,0,0,8" Background="Transparent" BorderThickness="0">
                        <Expander.Header>
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Padding="8,2" CornerRadius="3" Background="White"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                               Text="{Binding Status, Converter={StaticResource StatusText}}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                </Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Margin="10,0,0,0" FontWeight="SemiBold" Text="{Binding Summary}" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel Margin="24,6,0,0">
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                       Text="{Binding Evidence, StringFormat=原始输出：{0}{NewLine}}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="{Binding FixesText, StringFormat={}{0}}"
                                       Visibility="{Binding HasFixes, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                       Text="{Binding GuidanceText, StringFormat=指引：{0}}"
                                       Visibility="{Binding HasGuidance, Converter={StaticResource BoolToVisible}}" />
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>