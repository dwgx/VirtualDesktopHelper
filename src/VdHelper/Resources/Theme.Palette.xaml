<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        The palette and the metrics, in one place.

        These used to live inline in App.xaml. They had to move: a merged dictionary is loaded
        before the entries declared in the dictionary that merges it, so Theme.Controls.xaml could
        not resolve {StaticResource LineBrush} and the application died on startup with
        "Cannot find resource named 'LineBrush'". Splitting the palette out is what lets both files
        see the same tokens instead of one of them guessing.

        Values recovered from the official Streamer's XAML — three near-black greys, Verdana at
        14.667pt, 30px control height, #2E79BD as the pressed accent.
        Source: research/05-ui-reverse/01-ui-spec.md
    -->

    <SolidColorBrush x:Key="TitleBrush" Color="#1D1D1D" />
    <SolidColorBrush x:Key="BodyBrush" Color="#151515" />
    <SolidColorBrush x:Key="ContentBrush" Color="#101010" />
    <SolidColorBrush x:Key="InkBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2E79BD" />
    <SolidColorBrush x:Key="HoverBrush" Color="#262626" />
    <SolidColorBrush x:Key="LineBrush" Color="#2E2E2E" />

    <!-- Status colours. Measured against ContentBrush #101010 with the WCAG 2.x relative
         luminance formula: 8.93:1, 8.37:1, 5.27:1, 5.86:1 — every one above AA's 4.5:1 for body
         text. The hardcoded hexes these replaced measured 3.71 / 4.49 / 3.38 / 3.95:1 and all four
         failed. See StatusConverters.cs. -->
    <SolidColorBrush x:Key="PassBrush" Color="#5BC85B" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E0A030" />
    <SolidColorBrush x:Key="BlockBrush" Color="#E05B5B" />
    <SolidColorBrush x:Key="UnknownBrush" Color="#8A8F98" />

    <!-- Status shapes, 16x16, drawn rather than shipped as images.
         Colour is the fast channel and it is now above WCAG AA, but colour is also invisible to a
         reader with any colour vision deficiency, and "通过 / 警告 / 阻断" alone puts three different
         judgements in the same weight of text. Four silhouettes that stay apart in greyscale:
         filled circle, filled triangle, filled square, hollow circle. The official client only has
         two icons (AppsCheckerWindow.xaml:23-28) because it only has two states; we have four. -->
    <PathGeometry x:Key="GlyphPass" Figures="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 Z" />
    <PathGeometry x:Key="GlyphWarn" Figures="M8,1.5 L15,14 L1,14 Z" />
    <PathGeometry x:Key="GlyphBlock" Figures="M2,2 L14,2 L14,14 L2,14 Z" />
    <PathGeometry x:Key="GlyphUnknown" FillRule="EvenOdd" Figures="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 Z M8,4.5 A3.5,3.5 0 1 0 8,11.5 A3.5,3.3 0 1 0 8,4.5 Z" />

    <FontFamily x:Key="UiFont">Verdana, Microsoft YaHei UI</FontFamily>
    <sys:Double x:Key="BodySize">14.667</sys:Double>

</ResourceDictionary>
